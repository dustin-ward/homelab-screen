# Local configuration for homelab-screen. Fill these in on the host.
# This file is created by scripts/install.sh and must never be committed.
# Values are intentionally empty in source control.

# Read-only Proxmox API endpoint, e.g. https://<PVE-HOST>:8006/api2/json
PVE_API_BASE=
# PVE node name shown in the collector query, e.g. <NODE>
PVE_NODE=
# SHA-256 of the PVE leaf certificate DER, colon-free and lowercase.
PVE_CERT_PIN=
# Label shown in the kiosk header. Generic by default.
HOMELAB_LABEL=HOMELAB

# Optional overrides; leave empty to use defaults under the service user's home.
# The token and certificate are secrets/provisioned files and are not in git.
HOMELAB_TOKEN_FILE=
HOMELAB_CERT_FILE=
HOMELAB_PAGE_FILE=
HOMELAB_PORT=8080
