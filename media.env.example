# Media API configuration for the MEDIA page.
# Install this on the host as $HOME/.config/homelab-screen/media.env, mode 600.
# Values are intentionally empty in source control.

# Jellyfin: API key from Dashboard -> API Keys. Use the base URL only.
JELLYFIN_URL=
JELLYFIN_TOKEN=

# Sonarr / Radarr / Prowlarr: Settings -> General -> API Key.
SONARR_URL=
SONARR_API_KEY=
RADARR_URL=
RADARR_API_KEY=
PROWLARR_URL=
PROWLARR_API_KEY=

# qBittorrent: Web UI base URL and a dedicated read-only login.
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# NZBGet: XML-RPC endpoint and control login.
NZBGET_URL=
NZBGET_USERNAME=
NZBGET_PASSWORD=

# Optional overrides; leave empty to use defaults under the config home.
# MEDIA_ENV_FILE=
# MEDIA_STATE_FILE=
